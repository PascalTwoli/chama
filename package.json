{
  "name": "chama-monorepo",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "build:all": "pnpm -r build",
    "test:all": "pnpm -r test",
    "backend": "pnpm --filter chama-core start:dev",
    "frontend": "pnpm --filter chama-frontend start",
    "backend:prod": "pnpm --filter chama-core start:prod",
    "frontend:build": "pnpm --filter chama-frontend build",
    "backend:test": "pnpm --filter chama-core test",
    "frontend:test": "pnpm --filter chama-frontend test",
    "backend:lint": "pnpm --filter chama-core lint",
    "frontend:lint": "pnpm --filter chama-frontend lint",
    "backend:format": "pnpm --filter chama-core format",
    "frontend:format": "pnpm --filter chama-frontend format"
  },
  "dependencies": {
    "primeflex": "^4.0.0",
    "primereact": "^10.9.5",
    "react-router-dom": "^7.6.0",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@types/react": "^19.1.4"
  }
}
