{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "lib": ["ES2021"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declaration map": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0"
  },
  "include": ["chama-core/src/**/*", "chama-frontend/src/**/*"],
  "exclude": ["node_modules", "dist", "build"]
}
