generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Enums

/// Roles that users can have within the system or within a Chama
enum UserRole {
  ADMIN
  MEMBER
  TREASURER
  SECRETARY

  @@map("user_role")
}

/// Status of a contribution before/after processing
enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Supported payment methods (expand as needed)
enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
}

/// Status of an individual payment record
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Delivery channels for notifications (in-app, email, SMS)
enum DeliveryMethod {
  IN_APP
  EMAIL
  SMS
}

/// Transaction types for financial operations
enum TransactionType {
  CONTRIBUTION
  WITHDRAWAL
  LOAN
  LOAN_REPAYMENT
  INVESTMENT
  RETURN
  EXPENSE

  @@map("transaction_type")
}

/// Status of a transaction
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("transaction_status")
}

/// Models

model User {
  id           String   @id @default(uuid())
  name         String?
  email        String?  @unique
  phone        String?  @unique
  passwordHash String?  @map("password_hash")
  role         UserRole @default(MEMBER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    Membership[]
  contributions  Contribution[]
  notifications  Notification[]
  uiSettings     UiSettings?
  Chama          Chama[]
  transactions   Transaction[]
  activeUserType UserType?      @map("active_user_type")

  @@map("user")
}

model Chama {
  id          String   @id @default(uuid())
  name        String
  description String?
  rules       String?
  userId      String   @map("created_by") // User who created the Chama  Firebase user ID
  createdBy   User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships   Membership[]
  contributions Contribution[]
  invites       Invite[]
  transactions  Transaction[]

  @@map("chama")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  chamaId   String   @map("chama_id")
  chama     Chama    @relation(fields: [chamaId], references: [id])
  role      UserRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membership")
}

model Invite {
  id          String    @id @default(uuid())
  chamaId     String    @map("chama_id")
  chama       Chama     @relation(fields: [chamaId], references: [id])
  token       String    @unique
  sentToEmail String    @map("sent_to_email")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now())

  @@map("invite")
}

model Contribution {
  id        String             @id @default(uuid())
  chamaId   String             @map("chama_id")
  chama     Chama              @relation(fields: [chamaId], references: [id])
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id])
  amount    Decimal            @db.Decimal(10, 2)
  currency  String
  status    ContributionStatus @default(PENDING)
  date      DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  payments Payment[]

  @@map("contribution")
}

model Payment {
  id             String        @id @default(uuid())
  contributionId String        @map("contribution_id")
  contribution   Contribution  @relation(fields: [contributionId], references: [id])
  method         PaymentMethod @default(MPESA)
  externalRef    String?       @map("external_ref")
  status         PaymentStatus @default(PENDING)
  processedAt    DateTime?     @map("processed_at")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("payment")
}

model NotificationType {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  description     String?
  defaultDelivery DeliveryMethod @map("default_delivery")

  notifications Notification[]

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])
  typeId    Int              @map("type_id")
  type      NotificationType @relation(fields: [typeId], references: [id])
  title     String
  body      String
  readAt    DateTime?        @map("read_at")
  sentAt    DateTime?        @map("sent_at")
  createdAt DateTime         @default(now())

  @@map("notification")
}

model UiSettings {
  userId          String  @id @map("user_id")
  user            User    @relation(fields: [userId], references: [id])
  showTutorial    Boolean @default(true) @map("show_tutorial")
  theme           String? @default("default")
  lastSeenWidgets Json?   @map("last_seen_widgets")

  @@map("ui_settings")
}

enum UserType {
  ADMIN
  MEMBER
}

model Transaction {
  id          String            @id @default(uuid())
  type        TransactionType
  amount      Decimal           @db.Decimal(10, 2)
  chamaId     String            @map("chama_id")
  chama       Chama             @relation(fields: [chamaId], references: [id])
  userId      String            @map("user_id")
  user        User              @relation(fields: [userId], references: [id])
  description String?
  reference   String?
  status      TransactionStatus @default(COMPLETED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@map("transaction")
}
