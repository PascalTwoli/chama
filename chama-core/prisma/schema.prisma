generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(uuid())
  name           String?
  email          String?        @unique
  phone          String?        @unique
  passwordHash   String?        @map("password_hash")
  role           UserRole       @default(MEMBER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  activeUserType UserType?      @map("active_user_type")
  Chama          Chama[]
  contributions  Contribution[]
  memberships    Membership[]
  notifications  Notification[]
  transactions   Transaction[]
  uiSettings     UiSettings?

  @@map("user")
}

model Chama {
  id               String         @id @default(uuid())
  name             String
  description      String?
  rules            String?
  userId           String         @map("created_by")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  country          Countries      @map("country")
  membersCount     Int            @map("members_count")
  organizationRole UserRole?      @map("organization_role")
  createdBy        User           @relation(fields: [userId], references: [id])
  contributions    Contribution[]
  invites          Invite[]
  memberships      Membership[]
  transactions     Transaction[]

  @@map("chama")
}

model Membership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  chamaId   String   @map("chama_id")
  role      UserRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chama     Chama    @relation(fields: [chamaId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@map("membership")
}

model Invite {
  id          String    @id @default(uuid())
  chamaId     String    @map("chama_id")
  token       String    @unique
  sentToEmail String    @map("sent_to_email")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now())
  chama       Chama     @relation(fields: [chamaId], references: [id])

  @@map("invite")
}

model Contribution {
  id        String             @id @default(uuid())
  chamaId   String             @map("chama_id")
  userId    String             @map("user_id")
  amount    Decimal            @db.Decimal(10, 2)
  currency  String
  status    ContributionStatus @default(PENDING)
  date      DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  chama     Chama              @relation(fields: [chamaId], references: [id])
  user      User               @relation(fields: [userId], references: [id])
  payments  Payment[]

  @@map("contribution")
}

model Payment {
  id             String        @id @default(uuid())
  contributionId String        @map("contribution_id")
  method         PaymentMethod @default(MPESA)
  externalRef    String?       @map("external_ref")
  status         PaymentStatus @default(PENDING)
  processedAt    DateTime?     @map("processed_at")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  contribution   Contribution  @relation(fields: [contributionId], references: [id])

  @@map("payment")
}

model NotificationType {
  id              Int            @id @default(autoincrement())
  name            String         @unique
  description     String?
  defaultDelivery DeliveryMethod @map("default_delivery")
  notifications   Notification[]

  @@map("notification_type")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  typeId    Int              @map("type_id")
  title     String
  body      String
  readAt    DateTime?        @map("read_at")
  sentAt    DateTime?        @map("sent_at")
  createdAt DateTime         @default(now())
  type      NotificationType @relation(fields: [typeId], references: [id])
  user      User             @relation(fields: [userId], references: [id])

  @@map("notification")
}

model UiSettings {
  userId          String  @id @map("user_id")
  showTutorial    Boolean @default(true) @map("show_tutorial")
  theme           String? @default("default")
  lastSeenWidgets Json?   @map("last_seen_widgets")
  user            User    @relation(fields: [userId], references: [id])

  @@map("ui_settings")
}

model Transaction {
  id          String            @id @default(uuid())
  type        TransactionType
  amount      Decimal           @db.Decimal(10, 2)
  chamaId     String            @map("chama_id")
  userId      String            @map("user_id")
  description String?
  reference   String?
  status      TransactionStatus @default(COMPLETED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  chama       Chama             @relation(fields: [chamaId], references: [id])
  user        User              @relation(fields: [userId], references: [id])

  @@map("transaction")
}

/// Roles that users can have within the system or within a Chama
enum UserRole {
  ADMIN
  MEMBER
  TREASURER
  SECRETARY

  @@map("user_role")
}

/// Status of a contribution before/after processing
enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
}

/// Supported payment methods (expand as needed)
enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
}

/// Status of an individual payment record
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

/// Delivery channels for notifications (in-app, email, SMS)
enum DeliveryMethod {
  IN_APP
  EMAIL
  SMS
}

/// Transaction types for financial operations
enum TransactionType {
  CONTRIBUTION
  WITHDRAWAL
  LOAN
  LOAN_REPAYMENT
  INVESTMENT
  RETURN
  EXPENSE

  @@map("transaction_type")
}

/// Status of a transaction
enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED

  @@map("transaction_status")
}

