generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model chama {
  id                String          @id
  name              String
  description       String?
  rules             String?
  created_by        String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  country           country
  members_count     Int
  organization_role user_role?
  user              user            @relation(fields: [created_by], references: [id])
  contribution      contribution[]
  invite            invite[]
  join_request      join_request[]
  membership        membership[]
  transaction       transaction[]
  chama_settings    chama_settings?
  role_table        role[]
  expenses          expense[]
  expense_categories expense_category[]
  loans             loan[]
}

model contribution {
  id        String             @id
  chama_id  String
  user_id   String
  amount    Decimal            @db.Decimal(10, 2)
  currency  String
  status    ContributionStatus @default(PENDING)
  date      DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime
  chama     chama              @relation(fields: [chama_id], references: [id])
  user      user               @relation(fields: [user_id], references: [id])
  payment   payment[]
}

model invite {
  id            String    @id
  chama_id      String
  token         String    @unique
  sent_to_email String
  expires_at    DateTime
  used_at       DateTime?
  createdAt     DateTime  @default(now())
  chama         chama     @relation(fields: [chama_id], references: [id])
}

model join_request {
  id                                  String              @id
  chama_id                            String
  user_id                             String
  status                              join_request_status @default(PENDING)
  message                             String?
  createdAt                           DateTime            @default(now())
  updatedAt                           DateTime
  reviewed_by                         String?
  reviewed_at                         DateTime?
  chama                               chama               @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  user_join_request_reviewed_byTouser user?               @relation("join_request_reviewed_byTouser", fields: [reviewed_by], references: [id])
  user_join_request_user_idTouser     user                @relation("join_request_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chama_id, user_id])
  @@index([chama_id, status])
  @@index([user_id, status])
}

model membership {
  id        String    @id
  user_id   String
  chama_id  String
  role      user_role @default(MEMBER)
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime
  chama     chama     @relation(fields: [chama_id], references: [id])
  user      user      @relation(fields: [user_id], references: [id])

  @@unique([user_id, chama_id])
}

model notification {
  id             String             @id @default(uuid())
  user_id        String
  chama_id       String
  type_id        String
  audience       NotificationAudience
  title          String
  body           String
  entity_type    String?
  entity_id      String?
  action_required Boolean           @default(false)
  read_at        DateTime?
  createdAt      DateTime          @default(now())
  notification_type notification_type @relation(fields: [type_id], references: [id])
  user           user              @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, chama_id])
  @@index([read_at])
  @@index([user_id, chama_id, read_at])
}

model notification_type {
  id               String               @id @default(uuid())
  key              String               @unique
  description      String?
  default_audience NotificationAudience @default(MEMBER)
  action_required  Boolean              @default(false)
  createdAt        DateTime             @default(now())
  notification     notification[]
}

model payment {
  id              String        @id
  contribution_id String
  method          PaymentMethod @default(MPESA)
  external_ref    String?
  status          PaymentStatus @default(PENDING)
  processed_at    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  contribution    contribution  @relation(fields: [contribution_id], references: [id])
}

model transaction {
  id          String             @id
  type        transaction_type
  amount      Decimal            @db.Decimal(10, 2)
  chama_id    String
  user_id     String
  description String?
  reference   String?
  status      transaction_status @default(COMPLETED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime
  chama       chama              @relation(fields: [chama_id], references: [id])
  user        user               @relation(fields: [user_id], references: [id])
}

model ui_settings {
  user_id           String  @id
  show_tutorial     Boolean @default(true)
  theme             String? @default("default")
  last_seen_widgets Json?
  user              user    @relation(fields: [user_id], references: [id])
}

model chama_settings {
  id                       String                @id @default(uuid())
  chama_id                 String                @unique
  contribution_model       ContributionModel
  contribution_amount      Int?
  frequency                ContributionFrequency?
  due_day                  Int?
  grace_period_days        Int?
  late_payment_fee         Int?
  minimum_contribution     Int?
  contribution_guidelines  String?
  require_meeting_attendance Boolean             @default(false)
  enable_member_loans      Boolean               @default(false)
  automatic_sms_reminders  Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  chama                    chama                 @relation(fields: [chama_id], references: [id], onDelete: Cascade)
}

model user {
  id                                          String         @id
  name                                        String?
  email                                       String?        @unique
  phone                                       String?        @unique
  password_hash                               String?
  role                                        user_role      @default(MEMBER)
  system_role                                 system_role    @default(NONE)
  createdAt                                   DateTime       @default(now())
  updatedAt                                   DateTime
  active_user_type                            UserType?
  chama                                       chama[]
  contribution                                contribution[]
  join_request_join_request_reviewed_byTouser join_request[] @relation("join_request_reviewed_byTouser")
  join_request_join_request_user_idTouser     join_request[] @relation("join_request_user_idTouser")
  membership                                  membership[]
  notification                                notification[]
  transaction                                 transaction[]
  ui_settings                                 ui_settings?
  member_roles                                member_role[]
  expenses                                    expense[]
  expense_approvals                           expense[]     @relation("expense_approver")
  expense_rejections                          expense[]     @relation("expense_rejector")
  loans_borrowed                              loan[]        @relation("loan_borrower")
  loans_approved                              loan[]        @relation("loan_approver")
  loans_reviewed                              loan[]        @relation("loan_reviewer")
  loans_disbursed                             loan[]        @relation("loan_disburser")
  loan_repayments_recorded                   loan_repayment[]
}

model role {
  id          String            @id @default(uuid())
  chama_id    String
  name        String
  description String?
  is_default  Boolean           @default(false)
  createdAt   DateTime          @default(now())
  chama       chama             @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  role_permissions role_permission[]
  member_roles     member_role[]

  @@unique([chama_id, name])
  @@index([chama_id])
}

model permission {
  id          String            @id @default(uuid())
  key         String            @unique
  description String?
  role_permissions role_permission[]
}

model role_permission {
  role_id       String
  permission_id String
  role          role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model member_role {
  user_id   String
  chama_id  String
  role_id   String
  user      user   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role      role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, chama_id])
  @@index([chama_id])
}

model expense_category {
  id        String    @id @default(uuid())
  name      String
  chama_id  String?   // nullable so defaults can exist globally
  createdAt DateTime  @default(now())
  expenses  expense[]
  chama     chama?    @relation(fields: [chama_id], references: [id], onDelete: Cascade)

  @@unique([chama_id, name])
  @@index([chama_id])
}

model expense {
  id               String        @id @default(uuid())
  referenceCode    String        @unique // EXP-2026-001 format
  chamaId          String
  description      String
  amount           Decimal       @db.Decimal(10, 2)
  categoryId       String
  paidTo           String
  paymentMethod    PaymentMethod
  referenceNumber  String?
  expenseDate      DateTime
  notes            String?
  attachmentUrl    String?
  status           ExpenseStatus @default(PENDING)
  createdBy        String
  approvedBy       String?
  approvedAt       DateTime?
  rejectedBy       String?
  rejectedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  chama            chama         @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  category         expense_category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  creator          user          @relation(fields: [createdBy], references: [id])
  approver         user?         @relation("expense_approver", fields: [approvedBy], references: [id])
  rejector         user?         @relation("expense_rejector", fields: [rejectedBy], references: [id])

  @@index([chamaId])
  @@index([categoryId])
  @@index([createdBy])
  @@index([status])
  @@index([expenseDate])
}

model loan {
  id               String     @id @default(uuid())
  referenceCode    String     @unique
  chamaId          String
  borrowerId       String
  requestedAmount  Decimal    @db.Decimal(10, 2)
  approvedAmount   Decimal?   @db.Decimal(10, 2)
  interestRate     Decimal?   @db.Decimal(5, 2)
  durationMonths   Int
  purpose          String?
  status           LoanStatus @default(REQUESTED)
  requestedAt      DateTime   @default(now())
  reviewedAt       DateTime?
  approvedAt       DateTime?
  disbursedAt      DateTime?
  completedAt      DateTime?
  defaultedAt      DateTime?
  rejectedAt       DateTime?
  cancelledAt      DateTime?
  approvedBy       String?
  reviewedBy       String?
  disbursedBy      String?
  startDate        DateTime?
  dueDate          DateTime?
  principalAmount  Decimal?   @db.Decimal(10, 2)
  interestAmount   Decimal?   @db.Decimal(10, 2)
  totalPayable     Decimal?   @db.Decimal(10, 2)
  outstandingBalance Decimal? @db.Decimal(10, 2)
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  chama            chama      @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  borrower         user       @relation("loan_borrower", fields: [borrowerId], references: [id])
  approver         user?      @relation("loan_approver", fields: [approvedBy], references: [id])
  reviewer         user?      @relation("loan_reviewer", fields: [reviewedBy], references: [id])
  disburser        user?      @relation("loan_disburser", fields: [disbursedBy], references: [id])
  repayments       loan_repayment[]

  @@index([chamaId])
  @@index([borrowerId])
  @@index([status])
  @@index([chamaId, status])
  @@index([dueDate])
}

model loan_repayment {
  id          String        @id @default(uuid())
  loanId      String
  amount      Decimal       @db.Decimal(10, 2)
  paymentDate DateTime      @default(now())
  method      PaymentMethod
  reference   String?
  notes       String?
  recordedBy  String
  createdAt   DateTime      @default(now())
  loan        loan          @relation(fields: [loanId], references: [id], onDelete: Cascade)
  recorder    user          @relation(fields: [recordedBy], references: [id])

  @@index([loanId])
}

enum NotificationAudience {
  MEMBER
  ADMIN
  BOTH
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DeliveryMethod {
  IN_APP
  EMAIL
  SMS
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LoanStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  ACTIVE
  OVERDUE
  COMPLETED
  DEFAULTED
  CANCELLED
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

