generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model chama {
  id                String         @id
  name              String
  description       String?
  rules             String?
  created_by        String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  country           country
  members_count     Int
  organization_role user_role?
  user              user           @relation(fields: [created_by], references: [id])
  contribution      contribution[]
  invite            invite[]
  join_request      join_request[]
  membership        membership[]
  transaction       transaction[]
}

model contribution {
  id        String             @id
  chama_id  String
  user_id   String
  amount    Decimal            @db.Decimal(10, 2)
  currency  String
  status    ContributionStatus @default(PENDING)
  date      DateTime           @default(now())
  createdAt DateTime           @default(now())
  updatedAt DateTime
  chama     chama              @relation(fields: [chama_id], references: [id])
  user      user               @relation(fields: [user_id], references: [id])
  payment   payment[]
}

model invite {
  id            String    @id
  chama_id      String
  token         String    @unique
  sent_to_email String
  expires_at    DateTime
  used_at       DateTime?
  createdAt     DateTime  @default(now())
  chama         chama     @relation(fields: [chama_id], references: [id])
}

model join_request {
  id                                  String              @id
  chama_id                            String
  user_id                             String
  status                              join_request_status @default(PENDING)
  message                             String?
  createdAt                           DateTime            @default(now())
  updatedAt                           DateTime
  reviewed_by                         String?
  reviewed_at                         DateTime?
  chama                               chama               @relation(fields: [chama_id], references: [id], onDelete: Cascade)
  user_join_request_reviewed_byTouser user?               @relation("join_request_reviewed_byTouser", fields: [reviewed_by], references: [id])
  user_join_request_user_idTouser     user                @relation("join_request_user_idTouser", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([chama_id, user_id])
  @@index([chama_id, status])
  @@index([user_id, status])
}

model membership {
  id        String    @id
  user_id   String
  chama_id  String
  role      user_role @default(MEMBER)
  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime
  chama     chama     @relation(fields: [chama_id], references: [id])
  user      user      @relation(fields: [user_id], references: [id])

  @@unique([user_id, chama_id])
}

model notification {
  id                String            @id
  user_id           String
  type_id           Int
  title             String
  body              String
  read_at           DateTime?
  sent_at           DateTime?
  createdAt         DateTime          @default(now())
  notification_type notification_type @relation(fields: [type_id], references: [id])
  user              user              @relation(fields: [user_id], references: [id])
}

model notification_type {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  description      String?
  default_delivery DeliveryMethod
  notification     notification[]
}

model payment {
  id              String        @id
  contribution_id String
  method          PaymentMethod @default(MPESA)
  external_ref    String?
  status          PaymentStatus @default(PENDING)
  processed_at    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime
  contribution    contribution  @relation(fields: [contribution_id], references: [id])
}

model transaction {
  id          String             @id
  type        transaction_type
  amount      Decimal            @db.Decimal(10, 2)
  chama_id    String
  user_id     String
  description String?
  reference   String?
  status      transaction_status @default(COMPLETED)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime
  chama       chama              @relation(fields: [chama_id], references: [id])
  user        user               @relation(fields: [user_id], references: [id])
}

model ui_settings {
  user_id           String  @id
  show_tutorial     Boolean @default(true)
  theme             String? @default("default")
  last_seen_widgets Json?
  user              user    @relation(fields: [user_id], references: [id])
}

model user {
  id                                          String         @id
  name                                        String?
  email                                       String?        @unique
  phone                                       String?        @unique
  password_hash                               String?
  role                                        user_role      @default(MEMBER)
  createdAt                                   DateTime       @default(now())
  updatedAt                                   DateTime
  active_user_type                            UserType?
  chama                                       chama[]
  contribution                                contribution[]
  join_request_join_request_reviewed_byTouser join_request[] @relation("join_request_reviewed_byTouser")
  join_request_join_request_user_idTouser     join_request[] @relation("join_request_user_idTouser")
  membership                                  membership[]
  notification                                notification[]
  transaction                                 transaction[]
  ui_settings                                 ui_settings?
}

enum ContributionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DeliveryMethod {
  IN_APP
  EMAIL
  SMS
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

