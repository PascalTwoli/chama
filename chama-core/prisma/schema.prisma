enum join_request_status {
  PENDING
  APPROVED
  REJECTED
}

enum transaction_status {
  PENDING
  COMPLETED
  FAILED
}

enum transaction_type {
  CONTRIBUTION
  WITHDRAWAL
  LOAN
  LOAN_REPAYMENT
  INVESTMENT
  RETURN
  EXPENSE
}

